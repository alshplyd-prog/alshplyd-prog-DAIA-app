::text,    'إجمالي الديون والسلف بذمة الكادر';
SELECT '1. الزبائن والعقود' AS "القسم", COUNT()::text AS "العدد", COALESCE(SUM(remaining_balance), 0)::text || ' د.ع' AS "المجموع المالي" FROM sales WHERE id NOT IN (SELECT record_id FROM deleted_records WHERE table_name IN ('contracts', 'sales'))UNION ALLSELECT '2. قوائم الزبائن', COUNT()::text, '—' FROM customer_lists WHERE id NOT IN (SELECT record_id FROM deleted_records WHERE table_name = 'customer_lists')UNION ALLSELECT '3. المندوبين', COUNT()::text, '—' FROM reps WHERE id NOT IN (SELECT record_id FROM deleted_records WHERE table_name = 'reps')UNION ALLSELECT '4. الموظفين', COUNT()::text, '—' FROM employees WHERE id NOT IN (SELECT record_id FROM deleted_records WHERE table_name = 'employees')UNION ALLSELECT '5. ديون وسلف الموظفين', COUNT()::text, COALESCE(SUM(debt_balance), 0)::text || ' د.ع' FROM employees WHERE id NOT IN (SELECT record_id FROM deleted_records WHERE table_name = 'employees')UNION ALLSELECT '6. التسديدات الكلية', COUNT()::text, COALESCE(SUM(amount_paid), 0)::text || ' د.ع' FROM payments WHERE id NOT IN (SELECT record_id FROM deleted_records WHERE table_name = 'payments')UNION ALLSELECT '7. تسديدات اليوم', COUNT()::text, COALESCE(SUM(amount_paid), 0)::text || ' د.ع' FROM payments WHERE payment_date = CURRENT_DATE::text AND id NOT IN (SELECT record_id FROM deleted_records WHERE table_name = 'payments')UNION ALLSELECT '8. المخزن والمواد', COUNT()::text, COALESCE(SUM(purchase_price * quantity), 0)::text || ' د.ع' FROM inventory_items WHERE id NOT IN (SELECT record_id FROM deleted_records WHERE table_name = 'inventory_items')UNION ALLSELECT '9. الصناديق والخزائن', COUNT(*)::text, COALESCE(SUM(balance), 0)::text || ' د.ع' FROM cash_funds WHERE id NOT IN (SELECT record_id FROM deleted_records WHERE table_name = 'cash_funds');
SELECT name AS "اسم الموظف", phone AS "الهاتف", job_title AS "العنوان الوظيفي", salary AS "الراتب", debt_balance AS "السلف" FROM employees;
SELECT '1. الزبائن والعقود' AS "القسم", COUNT(*)::text AS "العدد", COALESCE(SUM(remaining_balance), 0)::text || ' د.ع' AS "المجموع المالي" FROM sales WHERE id NOT IN (SELECT record_id FROM deleted_records WHERE table_name IN ('contracts', 'sales'))UNION ALLSELECT '2. قوائم الزبائن', COUNT(*)::text, '—' FROM customer_lists WHERE id NOT IN (SELECT record_id FROM deleted_records WHERE table_name = 'customer_lists')UNION ALLSELECT '3. المندوبين', COUNT(*)::text, '—' FROM reps WHERE id NOT IN (SELECT record_id FROM deleted_records WHERE table_name = 'reps')UNION ALLSELECT '4. الموظفين', COUNT(*)::text, '—' FROM employees WHERE id NOT IN (SELECT record_id FROM deleted_records WHERE table_name = 'employees')UNION ALLSELECT '5. ديون وسلف الموظفين', COUNT(*)::text, COALESCE(SUM(debt_balance), 0)::text || ' د.ع' FROM employees WHERE id NOT IN (SELECT record_id FROM deleted_records WHERE table_name = 'employees')UNION ALLSELECT '6. التسديدات الكلية', COUNT(*)::text, COALESCE(SUM(amount_paid), 0)::text || ' د.ع' FROM payments WHERE id NOT IN (SELECT record_id FROM deleted_records WHERE table_name = 'payments')UNION ALLSELECT '7. تسديدات اليوم', COUNT(*)::text, COALESCE(SUM(amount_paid), 0)::text || ' د.ع' FROM payments WHERE payment_date = CURRENT_DATE::text AND id NOT IN (SELECT record_id FROM deleted_records WHERE table_name = 'payments')UNION ALLSELECT '8. المخزن والمواد', COUNT(*)::text, COALESCE(SUM(purchase_price * quantity), 0)::text || ' د.ع' FROM inventory_items WHERE id NOT IN (SELECT record_id FROM deleted_records WHERE table_name = 'inventory_items')UNION ALLSELECT '9. الصناديق والخزائن', COUNT(*)::text, COALESCE(SUM(balance), 0)::text || ' د.ع' FROM cash_funds WHERE id NOT IN (SELECT record_id FROM deleted_records WHERE table_name = 'cash_funds');
