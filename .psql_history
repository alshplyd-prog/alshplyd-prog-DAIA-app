PGPASSWORD='vOY9)hN0)5egF3cL' psql -h 72.62.158.128 -U app_user -d app_databaseSELECT COUNT(*) FROM customers;
SELECT COUNT(*) FROM customers;
SELECT     '1. قسم الزبائن والعقود' AS "القسم",    (SELECT COUNT(*) FROM sales WHERE id NOT IN (SELECT record_id FROM deleted_records WHERE table_name IN ('contracts', 'sales')))::text AS "العدد",    (SELECT COALESCE(SUM(remaining_balance), 0) FROM sales WHERE id NOT IN (SELECT record_id FROM deleted_records WHERE table_name IN ('contracts', 'sales')))::text AS "المجموع المالي (د.ع)",    'إجمالي الديون المتبقية بذمة الزبائن' AS "البيان"UNION ALLSELECT     '2. قسم التسديدات الكلية',    (SELECT COUNT(*) FROM payments WHERE id NOT IN (SELECT record_id FROM deleted_records WHERE table_name = 'payments'))::text,    (SELECT COALESCE(SUM(amount_paid), 0) FROM payments WHERE id NOT IN (SELECT record_id FROM deleted_records WHERE table_name = 'payments'))::text,    'إجمالي المبالغ المسددة الواصلة'UNION ALLSELECT     '3. تسديدات اليوم فقط',    (SELECT COUNT(*) FROM payments WHERE payment_date = CURRENT_DATE::text AND id NOT IN (SELECT record_id FROM deleted_records WHERE table_name = 'payments'))::text,    (SELECT COALESCE(SUM(amount_paid), 0) FROM payments WHERE payment_date = CURRENT_DATE::text AND id NOT IN (SELECT record_id FROM deleted_records WHERE table_name = 'payments'))::text,    'المبالغ المحصلة بتاريخ اليوم'UNION ALLSELECT     '4. قسم المخزن والمواد',    (SELECT COUNT(*) FROM inventory_items WHERE id NOT IN (SELECT record_id FROM deleted_records WHERE table_name = 'inventory_items'))::text,    (SELECT COALESCE(SUM(purchase_price * quantity), 0) FROM inventory_items WHERE id NOT IN (SELECT record_id FROM deleted_records WHERE table_name = 'inventory_items'))::text,    'إجمالي رأس مال بضاعة المخزن'UNION ALLSELECT     '5. قسم الصناديق والخزائن',    (SELECT COUNT(*) FROM cash_funds)::text,    (SELECT COALESCE(SUM(balance), 0) FROM cash_funds)::text,    'إجمالي الرصيد النقدي المتوفر'UNION ALLSELECT     '6. سلف وديون الموظفين والمندوبين',    (SELECT COUNT(*) FROM employees)::text,    (SELECT COALESCE(SUM(debt_balance), 0) FROM employees)::text,    'إجمالي الديون والسلف بذمة الكادر';
